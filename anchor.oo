// # oodiff3 Root Verification Anchor
//
// Logline: Unified test runner aggregating verification anchors from core, render, and ipc subsystems.
//
// Setup: Demands no ambient authority; invokes deterministic subsystem test routines.
//
// Beats:
//   1. Execute core Myers LCS, 3-way reconciliation, merge, and ed script checks.
//   2. Execute render ANSI color formatting and JSON stream serialization tests.
//   3. Execute ipc CLI argument parsing, JSON field extraction, and MCP protocol tests.
//   4. Return aggregate boolean test result.

import "core/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

pub fn run_all_tests() -> Bool {
    print("=== Starting oodiff3 Full Test Suite ===\n");
    if !run_core_tests() {
        print("FAIL: core tests failed\n");
        return false;
    }
    if !run_render_tests() {
        print("FAIL: render tests failed\n");
        return false;
    }
    if !run_ipc_tests() {
        print("FAIL: ipc tests failed\n");
        return false;
    }
    print("=== All oodiff3 Subsystems Verified Clean ===\n");
    return true;
}
