// # JSON Field Extraction Engine
//
// Logline: Character-indexed JSON substring search and field extraction for MCP requests.
//
// Setup: Pure string scanner extracting string, boolean, and integer fields from JSON payloads.
//
// Beats:
//   1. Perform exact character-based substring search avoiding index drift.
//   2. Extract double-quoted string fields for specified keys.
//   3. Extract boolean and integer values for specified keys.
//   4. Escape JSON string literals safely for JSON-RPC 2.0.

pub fn json_escape(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = str_slice(s, i, i + 1);
        if c == "\"" {
            out = out + "\\\"";
        } else if c == "\\" {
            out = out + "\\\\";
        } else if c == "\n" {
            out = out + "\\n";
        } else if c == "\t" {
            out = out + "\\t";
        } else if c == "\r" {
            out = out + "\\r";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

pub fn find_sub_char(haystack: String, needle: String) -> Int {
    let hn: Int = chars_len(haystack);
    let nn: Int = chars_len(needle);
    if nn == 0 { return 0; }
    if hn < nn { return -1; }
    let limit: Int = hn - nn;
    let mut i: Int = 0;
    while i <= limit {
        let sub: String = str_slice(haystack, i, i + nn);
        if sub == needle { return i; }
        i = i + 1;
    }
    return -1;
}

pub fn json_extract_str_field(json: String, key: String) -> String {
    let pat: String = "\"" + key + "\":\"";
    let pos: Int = find_sub_char(json, pat);
    if pos < 0 { return ""; }
    let start: Int = pos + chars_len(pat);
    let n: Int = chars_len(json);
    let mut end: Int = start;
    let mut escaped: Bool = false;
    while end < n {
        let c: String = str_slice(json, end, end + 1);
        if escaped {
            escaped = false;
        } else if c == "\\" {
            escaped = true;
        } else if c == "\"" {
            return str_slice(json, start, end);
        }
        end = end + 1;
    }
    return str_slice(json, start, end);
}

pub fn json_extract_bool_field(json: String, key: String, default_val: Bool) -> Bool {
    let pat: String = "\"" + key + "\":";
    let pos: Int = find_sub_char(json, pat);
    if pos < 0 { return default_val; }
    let start: Int = pos + chars_len(pat);
    let sub: String = str_slice(json, start, chars_len(json));
    if str_starts_with(sub, "true") { return true; }
    if str_starts_with(sub, "false") { return false; }
    return default_val;
}

pub fn json_extract_int_field(json: String, key: String, default_val: Int) -> Int {
    let pat1: String = "\"" + key + "\":";
    let pos1: Int = find_sub_char(json, pat1);
    let mut start: Int = -1;
    if pos1 >= 0 {
        start = pos1 + chars_len(pat1);
    } else {
        let pat2: String = "\"" + key + "\" :";
        let pos2: Int = find_sub_char(json, pat2);
        if pos2 >= 0 {
            start = pos2 + chars_len(pat2);
        }
    }
    if start < 0 {
        return default_val;
    }

    let n: Int = chars_len(json);
    let mut i: Int = start;
    while i < n {
        let c: String = str_slice(json, i, i + 1);
        if c != " " && c != "\t" && c != "\r" && c != "\n" {
            break;
        }
        i = i + 1;
    }

    let mut val: Int = 0;
    let mut found_digit: Bool = false;
    while i < n {
        let ch: Int = byte_at(json, i);
        if ch >= 48 && ch <= 57 {
            val = val * 10 + (ch - 48);
            found_digit = true;
        } else {
            break;
        }
        i = i + 1;
    }

    if found_digit {
        return val;
    }
    return default_val;
}
